</$objtype/mkfile

# T1 unit tests.  Each test is a self-contained program that exits
# non-zero and prints a one-line "FAIL: reason" when it fails.  To
# add one: write foo.c here and add foo to TESTS.
TESTS=\
	csumtest\
	structtest\
	geomtest\
	devtest\
	supertest\
	montest\
	fmtcktest\
	storetest\
	objtest\
	scrubtest\
	committest\
	enumtest\
	maptest\
	bmrebuildtest\
	peeropstest\
	srvtest\

LIB=../lib/libshoal.a$O
SRVLIB=../srv/libshoalsrv.a$O
HFILES=../lib/shoal.h ../lib/store.h t1.h
LDFLAGS=

PROGS=${TESTS:%=$O.%}

default:V:	all

all:V:	$PROGS

$O.%:	%.$O $LIB
	$LD $LDFLAGS -o $target $prereq

# srvtest drives the 9P surface, so it links the server library too and
# is a libthread program; every other test's link line is unchanged.
$O.srvtest:	srvtest.$O $SRVLIB $LIB
	$LD $LDFLAGS -o $target $prereq

srvtest.$O:	srvtest.c srv9p.h ../srv/srv.h $HFILES
	$CC $CFLAGS srvtest.c

%.$O:	%.c $HFILES
	$CC $CFLAGS $stem.c

test:V:	$PROGS
	for(t in $PROGS){
		echo '	'^$t
		./$t || exit 'test failed'
	}

clean nuke:V:
	rm -f *.[$OS] [$OS].* $CLEANFILES
